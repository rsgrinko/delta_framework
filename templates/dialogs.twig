{% extends 'layout.twig' %}
{% import '_icons.twig' as icons %}
{% block title %}Диалоги{% endblock %}
{% block main %}
    <div class="page-head">
        <div class="page-head-icon">{{ icons.chat() }}</div>
        <div>
            <h1>Диалоги {% if dialogs is not empty %}<span class="pill">{{ dialogs|length }}</span>{% endif %}</h1>
            <p class="page-subtitle">Личные сообщения с другими пользователями</p>
        </div>
    </div>

    {% if isAuthorized %}
        {% if dialogs is empty %}
            <div class="empty-state">
                {{ icons.chat() }}
                <span>Диалогов пока нет</span>
            </div>
        {% else %}
            <div class="dialog-list">
                {% for dialog in dialogs %}
                    <a class="dialog-row {% if dialog.unviewedCount > 0 %}has-unread{% endif %}" href="/dialog/{{ dialog.id }}">
                        <span class="avatar-wrap">
                            <span class="user-avatar">
                                {% if dialog.companionAvatar %}
                                    <img src="{{ dialog.companionAvatar }}" alt="{{ dialog.companionData.name }}">
                                {% else %}
                                    {{ (dialog.companionData.name|default(dialog.companionData.login))|slice(0, 1)|upper }}
                                {% endif %}
                            </span>
                            <span class="avatar-status-dot {% if dialog.companionOnline %}is-online{% endif %}"></span>
                        </span>
                        <div class="dialog-row-main">
                            <div class="dialog-row-top">
                                <strong>{{ dialog.companionData.name }}</strong>
                                {% if dialog.lastMessage %}
                                    <span class="dialog-row-time">{{ dialog.lastMessage.date|date('d.m.Y H:i') }}</span>
                                {% endif %}
                            </div>
                            <div class="dialog-row-preview">
                                {% if dialog.lastMessage %}
                                    {% if dialog.lastMessage.user_from == userId %}<span class="dialog-row-you">Вы:</span>{% endif %}
                                    {% if dialog.lastMessage.type == 'text' %}
                                        {{ dialog.lastMessage.text|slice(0, 80) }}{% if dialog.lastMessage.text|length > 80 %}&hellip;{% endif %}
                                    {% elseif dialog.lastMessage.type == 'image' %}
                                        {{ icons.paperclip() }} Изображение
                                    {% elseif dialog.lastMessage.type == 'file' %}
                                        {{ icons.paperclip() }} Файл
                                    {% endif %}
                                {% else %}
                                    <span class="dialog-row-empty">Сообщений пока нет</span>
                                {% endif %}
                            </div>
                        </div>
                        {% if dialog.unviewedCount > 0 %}
                            <span class="nav-badge">{{ dialog.unviewedCount }}</span>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    {% else %}
        <div class="alert alert-error">{{ icons.warning() }}<span>Вы не авторизованы</span></div>
    {% endif %}
{% endblock %}
