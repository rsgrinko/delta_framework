{% extends 'layout.twig' %}
{% import '_icons.twig' as icons %}
{% block title %}Диалоги{% endblock %}
{% block main %}
    <div class="page-head">
        <div class="page-head-icon">{{ icons.chat() }}</div>
        <div>
            <h1>Диалоги</h1>
            <p class="page-subtitle">Личные сообщения с другими пользователями</p>
        </div>
    </div>

    {% if isAuthorized %}
        <div class="section">
            <div class="section-title">
                <h2>{{ icons.chat() }} Мои диалоги</h2>
                {% if dialogs is not empty %}<span class="pill">{{ dialogs|length }} шт.</span>{% endif %}
            </div>

            {% if dialogs is empty %}
                <div class="empty-state">
                    {{ icons.chat() }}
                    <span>Диалогов пока нет</span>
                </div>
            {% else %}
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                        <tr>
                            <th>Собеседник</th>
                            <th style="width: 120px;">Статус</th>
                            <th style="width: 110px;">Сообщений</th>
                            <th style="width: 130px;">Непрочитанных</th>
                            <th style="width: 150px;"></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for dialog in dialogs %}
                            <tr>
                                <td>
                                    <div class="cell-user">
                                        <span class="user-avatar">{{ dialog.companionData.nameForDisplay|slice(0, 1)|upper }}</span>
                                        <div class="cell-user-meta">
                                            <span>{{ dialog.companionData.name }}</span>
                                            <span class="cell-user-sub">{{ dialog.companionData.login }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status {% if dialog.companionOnline %}is-online{% endif %}">
                                        <span class="status-dot"></span>
                                        {{ dialog.companionOnline ? 'Онлайн' : 'Не в сети' }}
                                    </span>
                                </td>
                                <td>{{ dialog.messagesCount }}</td>
                                <td>
                                    {% if dialog.unviewedCount > 0 %}
                                        <span class="nav-badge">{{ dialog.unviewedCount }}</span>
                                    {% else %}
                                        &mdash;
                                    {% endif %}
                                </td>
                                <td><a class="row-action" href="/dialog/{{ dialog.id }}">{{ icons.chat() }} Открыть</a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="alert alert-error">{{ icons.warning() }}<span>Вы не авторизованы</span></div>
    {% endif %}
{% endblock %}
