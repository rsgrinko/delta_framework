{
    "name": "rsgrinko/delta",
    "description": "Delta Framework",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Delta\\": "src/",
            "Core\\": "core/lib/Core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "rsgrinko",
            "email": "rsgrinko@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "twig/twig": "^3.0",
        "sentry/sdk": "^3.2",
      "ext-iconv": "*",
      "ext-curl": "*",
      "ext-json": "*",
      "ext-openssl": "*",
      "ext-simplexml": "*",
      "ext-dom": "*",
      "ext-pdo": "*",
      "ext-mbstring": "*",
      "ext-fileinfo": "*",
      "dompdf/dompdf": "^2.0",
      "robmorgan/phinx": "^0.13.4",
      "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.0"
        }
    }
}
