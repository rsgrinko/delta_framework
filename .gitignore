/vendor/

# Настройки IDE (содержат внутренние адреса и пути окружения)
/.idea/

# Локальная конфигурация и секреты — не коммитим никогда
/config.local.php
/.env

# Загружаемый пользователями контент (файлы из репозитория остаются отслеживаемыми)
/uploads/*
!/uploads/.htaccess
!/uploads/*.png

# Кэш ядра
/core/cache/*
!/core/cache/.gitkeep

# Логи ядра (index.php-заглушка остаётся)
/core/log/*
!/core/log/index.php

# Локальные утилиты и черновики
/composer.phar
/_scratch/
